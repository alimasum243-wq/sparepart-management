NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# TiDB / MySQL-compatible database
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=sparepart_db
DB_SSL=false
DB_SSL_CA=

# Authentication/session signing
# Generate a random secret at least 32 characters long in production.
AUTH_TOKEN_SECRET=
# One-time owner setup key; generate a strong 32+ character secret and remove/change it after bootstrap.
OWNER_SETUP_KEY=
